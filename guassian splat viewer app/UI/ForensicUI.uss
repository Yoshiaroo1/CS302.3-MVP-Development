/* ForensicNeRF viewer theme. Colours are taken from the mockup. */

.app {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(231, 237, 243);
    font-size: 14px;
    --accent: rgb(47, 167, 201);
    --accent-strong: rgb(60, 192, 228);
    --accent-bg: rgb(15, 46, 58);
    --panel: rgb(11, 20, 28);
    --panel-2: rgb(14, 25, 34);
    --line: rgb(22, 36, 47);
    --muted: rgb(142, 155, 168);
    --red: rgb(224, 69, 63);
}

/* ---------- Shared ---------- */

.flex-spacer {
    flex-grow: 1;
}

.fill {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.row-end {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 10px;
}

.row-start {
    flex-direction: row;
    margin-top: 8px;
}

.primary-button,
.ghost-button,
.danger-button {
    padding: 7px 16px;
    margin: 0 0 0 8px;
    border-radius: 7px;
    border-width: 1px;
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.row-start > .primary-button,
.row-start > .ghost-button {
    margin: 0 8px 0 0;
}

.primary-button {
    background-color: var(--accent-bg);
    border-color: var(--accent);
    color: rgb(231, 237, 243);
}

.primary-button:hover {
    background-color: rgb(20, 62, 77);
}

.primary-button.disabled {
    opacity: 0.4;
}

.ghost-button {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgb(38, 57, 74);
    color: rgb(201, 211, 220);
}

.ghost-button:hover {
    border-color: var(--accent);
    color: rgb(255, 255, 255);
}

.danger-button {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgb(110, 30, 34);
    color: rgb(240, 110, 104);
}

.danger-button:hover {
    background-color: rgb(58, 17, 20);
}

.chip {
    flex-direction: row;
    align-items: center;
    padding: 5px 12px;
    margin: 0 6px 0 0;
    border-radius: 14px;
    border-width: 1px;
    border-color: rgb(38, 57, 74);
    background-color: var(--panel-2);
    color: rgb(201, 211, 220);
    font-size: 12px;
}

.chip:hover {
    border-color: var(--accent);
    color: rgb(255, 255, 255);
}

.chip-text {
    margin: 0 0 0 4px;
    padding: 0;
    font-size: 12px;
}

.icon-button {
    width: 30px;
    height: 30px;
    border-radius: 6px;
    align-items: center;
    justify-content: center;
    color: rgb(174, 185, 195);
}

.icon-button:hover {
    background-color: rgb(20, 33, 44);
    color: rgb(255, 255, 255);
}

/* Form fields from the default runtime theme, recoloured */

.field {
    margin: 4px 0;
}

.field .unity-base-field__label {
    min-width: 96px;
    color: var(--muted);
    font-size: 12px;
}

.field .unity-base-text-field__input,
.path-field .unity-base-text-field__input {
    background-color: rgb(10, 18, 25);
    border-color: rgb(34, 49, 62);
    border-radius: 6px;
    color: rgb(231, 237, 243);
    padding: 4px 8px;
}

.field .unity-toggle__checkmark {
    background-color: rgb(10, 18, 25);
    border-color: rgb(52, 74, 92);
    border-radius: 4px;
    -unity-background-image-tint-color: var(--accent-strong);
}

.field .unity-base-slider__tracker,
.field .unity-min-max-slider__tracker {
    background-color: rgb(30, 44, 56);
    border-color: rgb(30, 44, 56);
}

.field .unity-base-slider__dragger {
    background-color: var(--accent);
    border-color: var(--accent);
}

.field .unity-min-max-slider__dragger {
    background-color: rgb(20, 72, 90);
    border-color: var(--accent);
}

.field .unity-min-max-slider__min-thumb,
.field .unity-min-max-slider__max-thumb {
    background-color: var(--accent-strong);
    border-color: var(--accent-strong);
}

.notes-field .unity-base-text-field__input {
    min-height: 64px;
    -unity-text-align: upper-left;
    white-space: normal;
}

/* ---------- Top bar ---------- */

.topbar {
    height: 74px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding: 0 16px;
    background-color: var(--panel);
    border-bottom-width: 1px;
    border-bottom-color: rgb(18, 50, 60);
}

.brand {
    flex-direction: row;
    align-items: center;
}

.logo-slot {
    width: 34px;
    height: 34px;
    color: var(--accent);
}

.brand-name {
    margin: 0 0 0 10px;
    padding: 0;
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(214, 223, 231);
}

.topbar-divider {
    width: 1px;
    align-self: stretch;
    margin: 14px 16px;
    background-color: rgb(28, 44, 56);
}

.scene-button {
    flex-direction: row;
    align-items: center;
    padding: 6px 8px 6px 10px;
    border-radius: 6px;
    max-width: 380px;
}

.scene-button:hover {
    background-color: rgb(18, 31, 41);
}

.scene-label {
    margin: 0;
    padding: 0;
    font-size: 13px;
    -unity-font-style: italic;
    color: rgb(154, 167, 180);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.scene-button:hover .scene-label {
    color: rgb(231, 237, 243);
}

.scene-caret {
    margin-left: 6px;
    color: rgb(110, 125, 138);
}

.mode-tabs {
    flex-direction: row;
    padding: 4px;
    border-radius: 12px;
    background-color: rgb(19, 29, 39);
}

.mode-tab {
    margin: 0 2px;
    padding: 7px 20px;
    border-radius: 9px;
    font-size: 15px;
    color: rgb(195, 205, 214);
    -unity-text-align: middle-center;
}

.mode-tab:hover {
    color: rgb(255, 255, 255);
    background-color: rgb(24, 36, 47);
}

.mode-tab.active {
    background-color: rgb(16, 48, 60);
    color: var(--accent-strong);
}

.export-button {
    margin: 0;
    padding: 9px 30px;
    border-width: 1px;
    border-color: rgb(52, 150, 178);
    border-radius: 6px;
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(231, 237, 243);
}

.export-button:hover {
    background-color: var(--accent-bg);
}

.export-button.disabled {
    opacity: 0.5;
}

.avatar-button {
    width: 40px;
    height: 40px;
    margin: 0;
    padding: 0;
    border-radius: 20px;
    border-width: 2px;
    border-color: var(--accent);
    color: var(--accent-strong);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.avatar-button:hover {
    background-color: var(--accent-bg);
}

/* ---------- Body ---------- */

.body {
    flex-grow: 1;
    flex-direction: row;
}

.toolbar {
    width: 70px;
    flex-shrink: 0;
    align-items: center;
    padding-top: 14px;
    background-color: var(--panel);
    border-right-width: 1px;
    border-right-color: var(--line);
}

.tool-button {
    width: 46px;
    height: 46px;
    margin-bottom: 8px;
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    align-items: center;
    justify-content: center;
    color: rgb(174, 185, 195);
}

.tool-button:hover {
    background-color: rgb(18, 31, 41);
}

.tool-button.selected {
    background-color: var(--accent-bg);
    border-color: rgb(42, 143, 174);
    color: var(--accent-strong);
}

/* ---------- Viewport ---------- */

.viewport {
    flex-grow: 1;
    overflow: hidden;
}

.gizmo-slot {
    position: absolute;
    top: 18px;
    right: 20px;
    width: 74px;
    height: 74px;
}

.axis-gizmo {
    flex-grow: 1;
    border-radius: 37px;
    border-width: 1px;
    border-color: rgb(36, 56, 74);
    background-color: rgba(14, 25, 34, 0.9);
}

.axis-label {
    position: absolute;
    margin: 0;
    padding: 0;
    font-size: 10px;
    -unity-font-style: bold;
    translate: -50% -50%;
}

.zoom-controls {
    position: absolute;
    right: 38px;
    bottom: 80px;
}

.zoom-button {
    width: 46px;
    height: 46px;
    margin-top: 10px;
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(38, 57, 74);
    background-color: rgba(14, 25, 34, 0.92);
    align-items: center;
    justify-content: center;
    color: rgb(201, 211, 220);
}

.zoom-button:hover {
    border-color: var(--accent);
    color: rgb(255, 255, 255);
}

.empty-state {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.empty-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(214, 223, 231);
}

.empty-sub {
    margin: 6px 0 18px 0;
    color: var(--muted);
}

.empty-state .primary-button {
    margin: 0;
    padding: 10px 26px;
    font-size: 14px;
}

.loading {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(8, 14, 20, 0.72);
    display: none;
}

.loading-label {
    font-size: 15px;
    color: rgb(214, 223, 231);
}

.progress-track {
    width: 320px;
    height: 6px;
    margin-top: 12px;
    border-radius: 3px;
    background-color: rgb(26, 39, 51);
    overflow: hidden;
}

.progress-fill {
    width: 0;
    height: 100%;
    border-radius: 3px;
    background-color: var(--accent);
}

.tool-hint {
    position: absolute;
    top: 18px;
    left: 50%;
    translate: -50% 0;
    padding: 6px 14px;
    border-radius: 16px;
    border-width: 1px;
    border-color: rgb(36, 56, 74);
    background-color: rgba(14, 25, 34, 0.92);
    font-size: 13px;
    color: rgb(201, 211, 220);
    white-space: nowrap;
}

.float-panel {
    position: absolute;
    padding: 14px;
    border-radius: 10px;
    border-width: 1px;
    border-color: rgb(34, 51, 63);
    background-color: rgba(13, 21, 29, 0.96);
    display: none;
}

.panel-title {
    margin: 0 0 6px 0;
    padding: 0;
    font-size: 15px;
    -unity-font-style: bold;
}

.crop-panel {
    top: 18px;
    left: 18px;
    width: 320px;
}

.compare-bar {
    bottom: 22px;
    left: 50%;
    translate: -50% 0;
    flex-direction: row;
    align-items: center;
    padding: 10px 14px;
}

.compare-caption {
    margin: 0 10px 0 0;
    color: var(--muted);
    font-size: 12px;
}

.compare-divider {
    width: 1px;
    height: 24px;
    margin: 0 12px 0 6px;
    background-color: rgb(34, 51, 63);
}

.segmented {
    flex-direction: row;
    padding: 3px;
    border-radius: 9px;
    background-color: rgb(19, 29, 39);
}

.segment {
    padding: 5px 14px;
    margin: 0;
    border-radius: 7px;
    font-size: 13px;
    color: rgb(195, 205, 214);
}

.segment:hover {
    color: rgb(255, 255, 255);
}

.segment.active {
    background-color: rgb(16, 48, 60);
    color: var(--accent-strong);
}

.toast {
    position: absolute;
    left: 22px;
    bottom: 22px;
    max-width: 70%;
    flex-direction: row;
    align-items: center;
    padding: 9px 14px;
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(42, 88, 102);
    background-color: rgba(16, 32, 42, 0.97);
    display: none;
}

.toast-label {
    margin: 0;
    padding: 0;
    font-size: 13px;
    white-space: normal;
    flex-shrink: 1;
}

.toast-action {
    margin: 0 0 0 14px;
    padding: 0;
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--accent-strong);
}

/* Markers drawn over the scan */

.marker {
    position: absolute;
    width: 30px;
    height: 30px;
    margin: 0;
    padding: 0;
    border-radius: 15px;
    border-width: 2px;
    border-color: rgb(142, 31, 37);
    background-color: rgba(40, 10, 13, 0.92);
    color: rgb(240, 81, 74);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    translate: -50% -50%;
}

.marker:hover {
    border-color: rgb(240, 81, 74);
}

.marker.marker-selected {
    border-color: rgb(255, 120, 112);
    background-color: rgb(110, 24, 28);
    color: rgb(255, 255, 255);
    scale: 1.15 1.15;
}

.measure-label {
    position: absolute;
    margin: 0;
    padding: 1px 8px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgb(158, 31, 31);
    color: rgb(245, 201, 198);
    font-size: 12px;
    white-space: nowrap;
    translate: -50% -50%;
}

.measure-label.selected {
    border-color: rgb(255, 255, 255);
    color: rgb(255, 255, 255);
}

/* ---------- Right panel ---------- */

.sidepanel {
    width: 440px;
    flex-shrink: 0;
    background-color: var(--panel);
    border-left-width: 1px;
    border-left-color: var(--line);
}

.side-tabs {
    height: 70px;
    flex-shrink: 0;
    flex-direction: row;
    border-bottom-width: 1px;
    border-bottom-color: var(--line);
}

.side-tab {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0;
    padding: 0;
    font-size: 16px;
    color: rgb(169, 180, 191);
    -unity-text-align: middle-center;
    border-bottom-width: 3px;
    border-bottom-color: rgba(0, 0, 0, 0);
}

.side-tab:hover {
    color: rgb(231, 237, 243);
}

.side-tab.active {
    color: rgb(231, 237, 243);
    -unity-font-style: bold;
    border-bottom-color: var(--accent);
}

.side-page {
    flex-grow: 1;
}

.section-header {
    margin: 0;
    padding: 20px 20px 8px 20px;
    font-size: 11px;
    letter-spacing: 2px;
    color: rgb(111, 125, 138);
}

.side-empty {
    margin: 0;
    padding: 10px 20px 14px 20px;
    font-size: 13px;
    color: var(--muted);
    white-space: normal;
}

.evidence-row {
    flex-direction: row;
    align-items: center;
    padding: 14px 20px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(21, 36, 49);
}

.evidence-row:hover {
    background-color: rgb(15, 27, 37);
}

.evidence-row.selected {
    background-color: rgb(16, 35, 46);
}

.badge {
    width: 42px;
    height: 42px;
    margin: 0 16px 0 0;
    padding: 0;
    flex-shrink: 0;
    border-radius: 21px;
    border-width: 2px;
    border-color: rgb(126, 28, 33);
    background-color: rgb(37, 13, 16);
    color: var(--red);
    font-size: 14px;
    -unity-text-align: middle-center;
}

.badge-small {
    width: 30px;
    height: 30px;
    margin-right: 12px;
    border-radius: 15px;
    font-size: 12px;
}

.evidence-text {
    flex-grow: 1;
    flex-shrink: 1;
}

.evidence-title {
    margin: 0;
    padding: 0;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(231, 237, 243);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.evidence-coords {
    margin: 3px 0 0 0;
    padding: 0;
    font-size: 12px;
    letter-spacing: 1px;
    color: var(--muted);
}

.measure-row {
    flex-direction: row;
    align-items: center;
    padding: 10px 14px 10px 20px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(21, 36, 49);
}

.measure-row:hover {
    background-color: rgb(15, 27, 37);
}

.measure-row.selected {
    background-color: rgb(16, 35, 46);
}

.measure-tag {
    margin: 0 14px 0 0;
    padding: 2px 8px;
    border-radius: 4px;
    background-color: rgb(158, 31, 31);
    color: rgb(245, 201, 198);
    font-size: 12px;
}

.measure-length {
    flex-grow: 1;
    margin: 0;
    padding: 0;
    font-size: 15px;
    -unity-font-style: bold;
}

.details {
    flex-shrink: 0;
    padding: 14px 20px 18px 20px;
    border-top-width: 1px;
    border-top-color: var(--line);
    background-color: rgb(13, 23, 32);
    display: none;
}

.details-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.details .evidence-coords {
    margin: 0;
}

.info-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 9px 20px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(20, 34, 48);
}

.info-key {
    margin: 0;
    padding: 0;
    flex-shrink: 0;
    font-size: 13px;
    color: var(--muted);
}

.info-value {
    margin: 0 0 0 16px;
    padding: 0;
    flex-shrink: 1;
    font-size: 13px;
    -unity-text-align: middle-right;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.info-block {
    padding: 0 20px;
}

.scale-label {
    margin: 0 0 4px 0;
    padding: 0;
    font-size: 15px;
    -unity-font-style: bold;
}

.help-text {
    margin: 0 0 8px 0;
    padding: 0;
    font-size: 12px;
    color: var(--muted);
    white-space: normal;
}

/* ---------- Capture mode (used while exporting the screenshot) ---------- */

.capture-mode .topbar,
.capture-mode .toolbar,
.capture-mode .sidepanel,
.capture-mode .gizmo-slot,
.capture-mode .zoom-controls,
.capture-mode .tool-hint,
.capture-mode .float-panel,
.capture-mode .toast {
    display: none;
}

/* ---------- File picker ---------- */

.modal-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(3, 7, 10, 0.66);
}

.modal {
    width: 720px;
    height: 560px;
    max-width: 92%;
    max-height: 90%;
    border-radius: 12px;
    border-width: 1px;
    border-color: rgb(34, 51, 63);
    background-color: rgb(13, 21, 29);
    color: rgb(231, 237, 243);
    overflow: hidden;
}

.modal-header {
    flex-direction: row;
    align-items: center;
    padding: 14px 14px 14px 20px;
    border-bottom-width: 1px;
    border-bottom-color: var(--line);
}

.modal-title {
    margin: 0;
    padding: 0;
    font-size: 17px;
    -unity-font-style: bold;
}

.modal-path-row {
    flex-direction: row;
    align-items: center;
    padding: 14px 20px 8px 20px;
}

.path-field {
    flex-grow: 1;
    margin: 0 8px 0 0;
}

.modal-quick-row {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 0 20px 12px 20px;
    border-bottom-width: 1px;
    border-bottom-color: var(--line);
}

.modal-quick-row > .chip {
    margin-top: 4px;
}

.modal-list {
    flex-grow: 1;
}

.picker-row {
    flex-direction: row;
    align-items: center;
    padding: 8px 20px;
    color: rgb(174, 185, 195);
}

.picker-row:hover {
    background-color: rgb(17, 30, 40);
}

.picker-row.selected {
    background-color: var(--accent-bg);
}

.folder-row {
    color: rgb(201, 167, 90);
}

.file-row {
    color: var(--accent-strong);
}

.picker-name {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0 0 0 12px;
    padding: 0;
    font-size: 14px;
    color: rgb(231, 237, 243);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.picker-meta {
    margin: 0 0 0 12px;
    padding: 0;
    font-size: 12px;
    color: var(--muted);
}

.modal-status {
    margin: 0;
    padding: 0 20px;
    font-size: 13px;
    color: var(--muted);
}

.modal-footer {
    flex-direction: row;
    align-items: center;
    padding: 12px 20px;
    border-top-width: 1px;
    border-top-color: var(--line);
}

.modal-hint {
    margin: 0;
    padding: 0;
    font-size: 12px;
    color: var(--muted);
}

/* ---------- User menu ---------- */

.menu-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.menu {
    position: absolute;
    top: 66px;
    right: 14px;
    width: 230px;
    padding: 6px;
    border-radius: 10px;
    border-width: 1px;
    border-color: rgb(34, 51, 63);
    background-color: rgb(15, 26, 36);
    color: rgb(231, 237, 243);
}

.menu-header {
    margin: 0;
    padding: 8px 12px 10px 12px;
    font-size: 13px;
    color: var(--muted);
    border-bottom-width: 1px;
    border-bottom-color: var(--line);
}

.menu-item {
    margin: 4px 0 0 0;
    padding: 9px 12px;
    border-radius: 6px;
    font-size: 14px;
}

.menu-item:hover {
    background-color: rgb(20, 35, 48);
}
